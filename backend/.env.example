# Copy this file to backend/.env and fill in the values.
# The real .env is git-ignored. Never commit API keys.

# --- Runtime ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# console (readable) or json (one object per line)
LOG_FORMAT=console
CORS_ORIGINS=["http://localhost:5173"]

# --- LLM providers ---------------------------------------------------------
# live calls the configured providers; mock answers locally with canned JSON,
# so the whole pipeline runs without keys or network access.
LLM_MODE=live

# A provider is used only when its model id (and, for hosted providers, its
# key) is set; leave either empty to disable it. After adding keys, run
# `uv run python scripts/list_models.py` to see the model ids you can use.
# Rate limits and task routing are in config/providers.yaml.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# Hugging Face fine-grained token with "Make calls to Inference Providers":
# https://huggingface.co/settings/tokens
# The large model reviews and verifies; the small one handles style review.
HF_TOKEN=
HF_MODEL_LARGE=
HF_MODEL_SMALL=

# NVIDIA API catalog key (starts with nvapi-): https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=

# A local OpenAI-compatible server, such as Ollama. No key is needed, and code
# sent to it never leaves this machine, so it works without consent to use
# hosted providers. Set the model to one you have pulled, e.g. `ollama list`.
LOCAL_MODEL=
LOCAL_BASE_URL=http://localhost:11434/v1

# --- Static analysis -------------------------------------------------------
# Opengrep is optional. Leave empty to use `opengrep` from PATH; the analyzer is
# reported as skipped when neither is available.
OPENGREP_PATH=
