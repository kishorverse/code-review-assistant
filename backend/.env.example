# Copy this file to backend/.env and fill in the values.
# The real .env is git-ignored. Never commit API keys.

# --- Runtime ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# console (readable) or json (one object per line)
LOG_FORMAT=console
CORS_ORIGINS=["http://localhost:5173"]

# --- LLM providers ---------------------------------------------------------
# Leave a key empty to disable that provider.
# After adding keys, run `uv run python scripts/list_models.py` to see which
# model ids each key can use.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hugging Face fine-grained token with "Make calls to Inference Providers":
# https://huggingface.co/settings/tokens
HF_TOKEN=

# NVIDIA API catalog key (starts with nvapi-): https://build.nvidia.com
NVIDIA_API_KEY=
