          }
        },
        "summary": "List Providers",
        "tags": [
          "providers"
        ]
      }
    },
    "/api/scans": {
      "post": {
        "description": "Upload a source file or a ``.zip`` and start scanning it.\n\nHosted models receive code only when ``allow_external`` is true.",
        "operationId": "create_scan_api_scans_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_scan_api_scans_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanInfo"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
