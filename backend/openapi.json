      "Finding": {
        "description": "One issue at one location.\n\nAttributes:\n    id: Unique id.\n    file_path: POSIX path relative to the upload root.\n    start_line: First affected line, 1-based.\n    end_line: Last affected line, inclusive.\n    start_column: 1-based column where the issue starts, when the tool reports it.\n    end_column: 1-based column where the issue ends, when the tool reports it.\n    category: Kind of issue.\n    severity: How urgent it is.\n    title: One-line summary of at most 80 characters.\n    message: What is wrong.\n    rationale: Why it matters; filled in by LLM review.\n    evidence: The offending code. Never contains a detected secret.\n    rule_id: The producing tool's rule identifier, such as ``F401`` or ``B602``.\n    sources: Tools or models that reported this issue.\n    confidence: 0 to 1; deterministic rules report 1.0.\n    status: Review state.\n    cwe: CWE identifier such as ``CWE-78``, when known.\n    suggestion: How to fix it, in a sentence; filled in by LLM review.\n    verified_by: Models that independently confirmed an issue another model reported.\n    ai_note: What AI review concluded when it questions the finding, such as why a\n        model dismissed it or disagreed with it.",
        "properties": {
          "ai_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ai Note"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "confidence": {
            "default": 1.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "cwe": {
            "anyOf": [
              {
                "pattern": "^CWE-\\d+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cwe"
          },
          "end_column": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Column"
          },
          "end_line": {
            "exclusiveMinimum": 0.0,
            "title": "End Line",
            "type": "integer"
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence"
          },
          "file_path": {
            "title": "File Path",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "rationale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rationale"
          },
          "rule_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rule Id"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Sources",
            "type": "array"
          },
          "start_column": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Column"
          },
          "start_line": {
            "exclusiveMinimum": 0.0,
            "title": "Start Line",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/FindingStatus",
            "default": "open"
          },
          "suggestion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggestion"
          },
          "title": {
            "maxLength": 80,
            "title": "Title",
            "type": "string"
          },
          "verified_by": {
            "items": {
              "type": "string"
            },
            "title": "Verified By",
            "type": "array"
          }
        },
