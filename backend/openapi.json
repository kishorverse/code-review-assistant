  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Report that the service is up.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
